<!--
  The design tokens every CodeAtlas view is built from. Views reference these keys
  and never literal colours, radii or sizes, so the visual language can be extended
  in one place as later screens are added.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces: a near-white canvas with white cards floating on it. -->
  <SolidColorBrush x:Key="CanvasBrush" Color="#F6F6F7" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F2F2F4" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EDEDEF" />
  <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E4E4E7" />
  <SolidColorBrush x:Key="DividerBrush" Color="#EAEAEC" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E2E5" />

  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18181B" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#71717A" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#A1A1AA" />

  <!-- Accent: the blue that marks what is selected — the section, the project, the
       endpoint. Selection is a light wash with a blue foreground rather than a filled
       dark block, so three levels of selection can be on screen at once without any of
       them shouting over the content they are selecting. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF4FF" />
  <SolidColorBrush x:Key="AccentBorderBrush" Color="#BFD3FE" />

  <!-- Emphasis: the single dark tone used for primary actions. -->
  <SolidColorBrush x:Key="EmphasisBrush" Color="#18181B" />
  <SolidColorBrush x:Key="EmphasisHoverBrush" Color="#27272A" />
  <SolidColorBrush x:Key="EmphasisPressedBrush" Color="#3F3F46" />
  <SolidColorBrush x:Key="OnEmphasisBrush" Color="#FFFFFF" />

  <!-- Semantic accents, used only for state. -->
  <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#ECFDF3" />
  <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#FEF6E7" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#B91C1C" />
  <SolidColorBrush x:Key="ErrorSoftBrush" Color="#FEF1F1" />
  <SolidColorBrush x:Key="InfoBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="InfoSoftBrush" Color="#EFF4FF" />

  <!-- Focus -->
  <SolidColorBrush x:Key="FocusRingBrush" Color="#2563EB" />

  <!-- HTTP verbs. Read-only, creating, replacing and removing are four different
       consequences, and the list is scanned for exactly that difference. -->
  <SolidColorBrush x:Key="VerbGetBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="VerbGetSoftBrush" Color="#EFF4FF" />
  <SolidColorBrush x:Key="VerbPostBrush" Color="#15803D" />
  <SolidColorBrush x:Key="VerbPostSoftBrush" Color="#ECFDF3" />
  <SolidColorBrush x:Key="VerbPutBrush" Color="#B45309" />
  <SolidColorBrush x:Key="VerbPutSoftBrush" Color="#FEF6E7" />
  <SolidColorBrush x:Key="VerbDeleteBrush" Color="#B91C1C" />
  <SolidColorBrush x:Key="VerbDeleteSoftBrush" Color="#FEF1F1" />

  <!-- Corner radii -->
  <CornerRadius x:Key="RadiusCard">14</CornerRadius>
  <CornerRadius x:Key="RadiusButton">10</CornerRadius>
  <CornerRadius x:Key="RadiusInput">10</CornerRadius>
  <CornerRadius x:Key="RadiusRow">8</CornerRadius>
  <CornerRadius x:Key="RadiusChip">8</CornerRadius>

  <!-- Elevation is defined on the `card` and flyout styles in Controls.axaml,
       because BoxShadows has no resource form to name here. -->

  <!-- Icons: one stroked line set at a 24x24 origin, scaled by the `icon` style. -->
  <StreamGeometry x:Key="Icon.Explorer">M4 7a2 2 0 0 1 2-2h3l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Endpoints">M4 8h16 M4 16h16 M9 4 7 20 M17 4l-2 16</StreamGeometry>
  <StreamGeometry x:Key="Icon.Refresh">M20 12a8 8 0 1 1-2.3-5.6 M20 3v4h-4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Indexing">M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3z M4 7v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7 M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3</StreamGeometry>
  <StreamGeometry x:Key="Icon.Project">M12 3 3 7.5v9L12 21l9-4.5v-9z M3 7.5 12 12l9-4.5 M12 12v9</StreamGeometry>
  <StreamGeometry x:Key="Icon.Chevron">M7 10l5 5 5-5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Code">M9 7 4 12l5 5 M15 7l5 5-5 5</StreamGeometry>

  <!-- Typography -->
  <!-- The UI face is Inter, embedded by Program.WithInterFont() and applied as the
       default family; only the monospace face has to be named here. -->
  <FontFamily x:Key="MonoFontFamily">JetBrains Mono, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>

  <x:Double x:Key="FontSizeTitle">22</x:Double>
  <x:Double x:Key="FontSizeSectionTitle">14</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeSmall">12</x:Double>
  <x:Double x:Key="FontSizeCaption">11</x:Double>

  <!-- Fixed shell dimensions, shared so every future screen lines up with the shell. -->
  <x:Double x:Key="TopBarHeight">60</x:Double>
  <x:Double x:Key="SidebarWidth">320</x:Double>
  <x:Double x:Key="DetailsWidth">380</x:Double>
  <x:Double x:Key="StatusBarHeight">30</x:Double>

</ResourceDictionary>
