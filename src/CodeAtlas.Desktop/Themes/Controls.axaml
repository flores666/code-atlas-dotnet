<!--
  The shared control language: every button, input, card, row and badge in the app
  comes from here. Views use `Classes=` or `Theme=` and add no styling of their own,
  so a later screen inherits the same look by construction.

  Control themes are written out in full where the Fluent template would fight the
  design (navigation rows, buttons, list rows); everything else is a light override
  on top of Fluent.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>

  <!-- ==================== Buttons ==================== -->

  <ControlTheme x:Key="PrimaryButtonTheme" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource EmphasisBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnEmphasisBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Surface"
                Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource RadiusButton}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource EmphasisHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource EmphasisPressedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="SecondaryButtonTheme" TargetType="Button" BasedOn="{StaticResource PrimaryButtonTheme}">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Surface"
                Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusButton}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
    </Style>
  </ControlTheme>

  <!-- Square-ish, icon-only affordance for compact toolbar actions. -->
  <ControlTheme x:Key="IconButtonTheme" TargetType="Button" BasedOn="{StaticResource PrimaryButtonTheme}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Style Selector="^:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
    </Style>
  </ControlTheme>

  <!-- A borderless row: used for links, relation targets and recent projects. -->
  <ControlTheme x:Key="GhostButtonTheme" TargetType="Button" BasedOn="{StaticResource PrimaryButtonTheme}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Style Selector="^:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
    </Style>
  </ControlTheme>

  <!-- A toggle shaped like a chip: the graph's edge-type filters. -->
  <ControlTheme x:Key="FilterChipTheme" TargetType="ToggleButton">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Surface"
                Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource RadiusChip}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource OnEmphasisBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource EmphasisBrush}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource EmphasisHoverBrush}" />
    </Style>
  </ControlTheme>

  <!-- ==================== Sidebar navigation ==================== -->

  <ControlTheme x:Key="NavItemTheme" TargetType="RadioButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Surface"
                Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource RadiusRow}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource OnEmphasisBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:checked /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource EmphasisBrush}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource EmphasisHoverBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- ==================== Inputs ==================== -->

  <ControlTheme x:Key="SearchBoxTheme" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource SurfacePressedBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Surface"
                Background="{TemplateBinding Background}"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusInput}"
                Padding="10,0">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <ContentPresenter Grid.Column="0" Content="{TemplateBinding InnerLeftContent}"
                              VerticalAlignment="Center" />
            <Panel Grid.Column="1" Margin="8,0">
              <TextBlock Name="PART_Watermark"
                         Text="{TemplateBinding PlaceholderText}"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         VerticalAlignment="Center"
                         IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
              <TextPresenter Name="PART_TextPresenter"
                             Text="{TemplateBinding Text, Mode=TwoWay}"
                             CaretBrush="{TemplateBinding CaretBrush}"
                             SelectionBrush="{TemplateBinding SelectionBrush}"
                             SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                             SelectionStart="{TemplateBinding SelectionStart}"
                             SelectionEnd="{TemplateBinding SelectionEnd}"
                             VerticalAlignment="Center" />
            </Panel>
            <ContentPresenter Grid.Column="2" Content="{TemplateBinding InnerRightContent}"
                              VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="^:focus /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
    </Style>
  </ControlTheme>

  <!-- ==================== Result rows ==================== -->

  <ControlTheme x:Key="ResultListTheme" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" Margin="{TemplateBinding Padding}" />
        </ScrollViewer>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="ResultRowTheme" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Surface"
                Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource RadiusRow}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource EmphasisBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource OnEmphasisBrush}" />
    </Style>
  </ControlTheme>

  </Styles.Resources>

  <!-- ==================== Text ==================== -->

  <!--
    No Foreground here: TextBlocks inherit it, which is what lets a selected row
    invert everything inside it in one setter.
  -->
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  </Style>

  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- Secondary text inside a selectable row: dimmed by opacity, not by colour, so it
       stays legible once the row turns charcoal. -->
  <Style Selector="TextBlock.dim">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="Opacity" Value="0.62" />
  </Style>

  <Style Selector="TextBlock.dimmer">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSectionTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>

  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
  </Style>

  <Style Selector="SelectableTextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource SurfacePressedBrush}" />
  </Style>

  <Style Selector="SelectableTextBlock.meta">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
  </Style>

  <!-- ==================== Surfaces ==================== -->

  <!-- A floating white card. -->
  <!-- Elevation lives here rather than in Tokens: BoxShadows has no resource form,
       so the two levels the design uses are written out where they are applied. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #0A18181B, 0 8 24 -10 #1418181B" />
  </Style>

  <!-- A quiet inset surface: stat tiles, metadata blocks. -->
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusRow}" />
  </Style>

  <!-- Compact label: kinds, severities, counts. -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusChip}" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Border.chip.warning">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.warning > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Border.chip.error">
    <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.error > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <Style Selector="Border.chip.success">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.success > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <!-- The square badge that carries a symbol-kind glyph. -->
  <Style Selector="Border.glyph">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.glyph > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <Style Selector="Border.glyph.container">
    <Setter Property="Background" Value="{DynamicResource EmphasisBrush}" />
  </Style>

  <Style Selector="Border.glyph.container > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnEmphasisBrush}" />
  </Style>

  <Style Selector="Border.glyph.large">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="Border.glyph.large > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  </Style>

  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="RadioButton:checked Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource OnEmphasisBrush}" />
  </Style>

  <Style Selector="ListBoxItem:selected Border.glyph">
    <Setter Property="Background" Value="#33FFFFFF" />
  </Style>

  <Style Selector="ListBoxItem:selected Border.glyph > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnEmphasisBrush}" />
  </Style>

  <!-- A hairline used between structurally adjacent panels. -->
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- The HTTP verb badge. Fixed width so a column of routes stays aligned. -->
  <Style Selector="Border.verb">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusChip}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Width" Value="62" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.verb > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <Style Selector="ListBoxItem:selected Border.verb">
    <Setter Property="Background" Value="#33FFFFFF" />
  </Style>

  <Style Selector="ListBoxItem:selected Border.verb > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnEmphasisBrush}" />
  </Style>

  <!-- ==================== Graph ==================== -->

  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusButton}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- One of a set of mutually exclusive small choices, such as the graph depth. -->
  <Style Selector="Button.segment">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="MinWidth" Value="32" />
  </Style>

  <Style Selector="Button.segment.selected">
    <Setter Property="Foreground" Value="{DynamicResource OnEmphasisBrush}" />
  </Style>

  <Style Selector="Button.segment.selected /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource EmphasisBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EmphasisBrush}" />
  </Style>

  <Style Selector="Button.graphnode">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- The root of the neighbourhood reads as the subject of the picture. -->
  <Style Selector="Button.graphnode.root /template/ Border#Surface">
    <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <Style Selector="Button.graphnode.selected">
    <Setter Property="Foreground" Value="{DynamicResource OnEmphasisBrush}" />
  </Style>

  <Style Selector="Button.graphnode.selected /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource EmphasisBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EmphasisBrush}" />
  </Style>

  <Style Selector="Button.graphnode.selected Border.glyph">
    <Setter Property="Background" Value="#33FFFFFF" />
  </Style>

  <Style Selector="Button.graphnode.selected Border.glyph > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnEmphasisBrush}" />
  </Style>

  <!-- ==================== Project tree ==================== -->

  <Style Selector="TreeView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusRow}" />
    <Setter Property="Margin" Value="0,1" />
  </Style>

  <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource EmphasisBrush}" />
  </Style>

  <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource EmphasisHoverBrush}" />
  </Style>

  <Style Selector="TreeViewItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource OnEmphasisBrush}" />
  </Style>

  <Style Selector="TreeViewItem:selected /template/ ToggleButton#PART_ExpandCollapseChevron">
    <Setter Property="Foreground" Value="{DynamicResource OnEmphasisBrush}" />
  </Style>

  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <!-- ==================== Progress ==================== -->

  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource EmphasisBrush}" />
  </Style>


</Styles>
