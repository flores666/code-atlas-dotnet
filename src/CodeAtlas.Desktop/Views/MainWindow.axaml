<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodeAtlas.Desktop.ViewModels"
        xmlns:views="using:CodeAtlas.Desktop.Views"
        xmlns:model="using:CodeAtlas.Core.Model"
        xmlns:editor="using:AvaloniaEdit"
        x:Class="CodeAtlas.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CodeAtlas.NET"
        Width="1600" Height="980"
        MinWidth="1080" MinHeight="680"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

  <Window.Resources>
    <views:EnumEqualsConverter x:Key="Is" />
  </Window.Resources>

  <DockPanel>

    <!-- Title bar. The solution name in the middle is the picker: the solutions opened
         before, then the file and folder pickers that add to them. -->

    <Border DockPanel.Dock="Top"
            Height="{DynamicResource TopBarHeight}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,0">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Classes="glyph container large">
            <Path Classes="icon" Data="{DynamicResource Icon.Code}" Width="15" Height="15" />
          </Border>
          <TextBlock Text="CodeAtlas" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border Classes="chip">
            <TextBlock Text=".NET" />
          </Border>
          <TextBlock Classes="meta" Margin="8,0,0,0" VerticalAlignment="Center"
                     Text="Index a solution. Trace what an endpoint runs." />
        </StackPanel>

        <Button Grid.Column="1" Name="WorkspaceButton"
                Theme="{DynamicResource SecondaryButtonTheme}"
                Padding="14,7" MinWidth="280" MaxWidth="420"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                HorizontalContentAlignment="Stretch"
                ToolTip.Tip="Choose a solution">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Path Grid.Column="0" Classes="icon" Data="{DynamicResource Icon.Project}"
                  Width="15" Height="15" />
            <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Center">
              <TextBlock Text="{Binding WorkspaceTitle}" FontWeight="Medium"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding WorkspacePath}" Classes="caption"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding HasWorkspace}" />
            </StackPanel>
            <Path Grid.Column="2" Classes="icon" Data="{DynamicResource Icon.Chevron}"
                  Width="14" Height="14" />
          </Grid>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Width="320" Spacing="2">
                <TextBlock Classes="overline" Text="Recent" Margin="8,4"
                           IsVisible="{Binding HasRecentWorkspaces}" />
                <ItemsControl ItemsSource="{Binding RecentWorkspaces}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentWorkspaceViewModel">
                      <Button Theme="{DynamicResource GhostButtonTheme}"
                              HorizontalAlignment="Stretch"
                              Command="{Binding OpenCommand}"
                              CommandParameter="{Binding Path}"
                              ToolTip.Tip="{Binding Path}">
                        <StackPanel MinWidth="0">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Directory}" Classes="caption"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="divider" Margin="0,4" />
                <Button Name="OpenFileButton"
                        Theme="{DynamicResource GhostButtonTheme}"
                        HorizontalAlignment="Stretch"
                        Content="Solution or project file…" />
                <Button Name="OpenFolderButton"
                        Theme="{DynamicResource GhostButtonTheme}"
                        HorizontalAlignment="Stretch"
                        Content="Repository folder…" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Theme="{DynamicResource SecondaryButtonTheme}"
                  Command="{Binding ReindexCommand}"
                  IsVisible="{Binding HasWorkspace}"
                  ToolTip.Tip="Rebuild the index from source">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Classes="icon" Data="{DynamicResource Icon.Refresh}" Width="14" Height="14" />
              <TextBlock Text="Reindex" />
            </StackPanel>
          </Button>

          <Button Theme="{DynamicResource SecondaryButtonTheme}"
                  Content="Cancel"
                  Command="{Binding CancelIndexingCommand}"
                  IsVisible="{Binding IsIndexing}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The projects of the open solution. Selecting one scopes the explorer and the
         endpoint list to it; the solution's own card is what "all of them" is. -->

    <StackPanel DockPanel.Dock="Top" Margin="20,18,20,0" Spacing="12"
                IsVisible="{Binding HasProjects}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="Solution projects" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Classes="meta" VerticalAlignment="Center"
                   Text="Select one to scope the explorer and the endpoints to it" />
      </StackPanel>

      <ListBox ItemsSource="{Binding Projects}"
               SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
               Theme="{DynamicResource ProjectStripTheme}"
               ItemContainerTheme="{DynamicResource ProjectCardTheme}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectCardViewModel">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="glyph large"
                      Classes.container="{Binding IsSolution}"
                      VerticalAlignment="Center">
                <Path Classes="icon" Data="{DynamicResource Icon.Project}" Width="14" Height="14" />
              </Border>
              <StackPanel Grid.Column="1" MinWidth="0" Spacing="1">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium"
                             TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" Classes="chip warning" IsVisible="{Binding !IsLoaded}">
                    <TextBlock Text="not loaded" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding Detail}" Classes="caption"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                <TextBlock Text="{Binding Metric}" Classes="caption" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>

    <!-- Status bar -->

    <Border DockPanel.Dock="Bottom"
            Height="{DynamicResource StatusBarHeight}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Margin="0,18,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="20,0">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Classes="meta"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <ProgressBar Width="140"
                       IsVisible="{Binding IsIndexing}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}"
                       Minimum="0"
                       Maximum="{Binding ProgressMaximum}"
                       Value="{Binding ProgressValue}" />
          <TextBlock Classes="meta" IsVisible="{Binding HasWorkspace}"
                     Text="{Binding SymbolCount, StringFormat='{}{0:N0} symbols'}" />
          <TextBlock Classes="meta" IsVisible="{Binding HasWorkspace}"
                     Text="{Binding ProjectCount, StringFormat='{}{0} projects'}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Three panes: what to look at, the code, and what the endpoint runs. -->

    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18" Margin="20,18,20,0">

      <!-- ============ Sidebar: the sections, then the active one's list ============ -->

      <Border Grid.Column="0" Classes="card" Width="{DynamicResource SidebarWidth}"
              ClipToBounds="True">
        <DockPanel Margin="12,14">

          <StackPanel DockPanel.Dock="Top" Spacing="4">
            <RadioButton Theme="{DynamicResource NavItemTheme}" GroupName="Section"
                         Padding="12,10"
                         IsChecked="{Binding ActiveSection, Mode=TwoWay,
                                     Converter={StaticResource Is},
                                     ConverterParameter={x:Static vm:AppSection.Indexing}}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Path Grid.Column="0" Classes="icon" Data="{DynamicResource Icon.Indexing}"
                      Width="18" Height="18" />
                <StackPanel Grid.Column="1" MinWidth="0">
                  <TextBlock Text="Indexing" FontWeight="SemiBold" />
                  <TextBlock Text="Scan and index this solution" Classes="caption" />
                </StackPanel>
              </Grid>
            </RadioButton>

            <RadioButton Theme="{DynamicResource NavItemTheme}" GroupName="Section"
                         Padding="12,10"
                         IsEnabled="{Binding HasWorkspace}"
                         IsChecked="{Binding ActiveSection, Mode=TwoWay,
                                     Converter={StaticResource Is},
                                     ConverterParameter={x:Static vm:AppSection.Explorer}}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Path Grid.Column="0" Classes="icon" Data="{DynamicResource Icon.Explorer}"
                      Width="18" Height="18" />
                <StackPanel Grid.Column="1" MinWidth="0">
                  <TextBlock Text="Explorer" FontWeight="SemiBold" />
                  <TextBlock Text="Browse what was declared" Classes="caption" />
                </StackPanel>
              </Grid>
            </RadioButton>

            <RadioButton Theme="{DynamicResource NavItemTheme}" GroupName="Section"
                         Padding="12,10"
                         IsEnabled="{Binding HasWorkspace}"
                         IsChecked="{Binding ActiveSection, Mode=TwoWay,
                                     Converter={StaticResource Is},
                                     ConverterParameter={x:Static vm:AppSection.Endpoints}}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Path Grid.Column="0" Classes="icon" Data="{DynamicResource Icon.Endpoints}"
                      Width="18" Height="18" />
                <StackPanel Grid.Column="1" MinWidth="0">
                  <TextBlock Text="Endpoints" FontWeight="SemiBold" />
                  <TextBlock Text="Explore and trace API endpoints" Classes="caption" />
                </StackPanel>
                <TextBlock Grid.Column="2" Classes="dim" VerticalAlignment="Center"
                           IsVisible="{Binding HasAnyEndpoints}"
                           Text="{Binding EndpointCount}" />
              </Grid>
            </RadioButton>

            <Border Classes="divider" Margin="0,10,0,4" />
          </StackPanel>

          <Panel>

            <!-- Indexing -->
            <DockPanel IsVisible="{Binding ActiveSection, Converter={StaticResource Is},
                                   ConverterParameter={x:Static vm:AppSection.Indexing}}">
              <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="2,4,2,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                           Fill="{DynamicResource TextTertiaryBrush}"
                           IsVisible="{Binding !HasWorkspace}" />
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                           Fill="{DynamicResource SuccessBrush}"
                           IsVisible="{Binding Health, Converter={StaticResource Is},
                                       ConverterParameter={x:Static vm:IndexHealth.Ready}}" />
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                           Fill="{DynamicResource InfoBrush}"
                           IsVisible="{Binding Health, Converter={StaticResource Is},
                                       ConverterParameter={x:Static vm:IndexHealth.Indexing}}" />
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                           Fill="{DynamicResource WarningBrush}"
                           IsVisible="{Binding Health, Converter={StaticResource Is},
                                       ConverterParameter={x:Static vm:IndexHealth.Warnings}}" />
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                           Fill="{DynamicResource ErrorBrush}"
                           IsVisible="{Binding Health, Converter={StaticResource Is},
                                       ConverterParameter={x:Static vm:IndexHealth.Failed}}" />
                  <TextBlock Text="{Binding IndexStateText}" FontWeight="Medium" />
                </StackPanel>

                <TextBlock Classes="caption" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding IndexedAtText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding IndexedAtText, StringFormat='Last indexed {0}'}" />

                <StackPanel Spacing="8" IsVisible="{Binding IsIndexing}">
                  <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}"
                               Minimum="0"
                               Maximum="{Binding ProgressMaximum}"
                               Value="{Binding ProgressValue}" />
                  <TextBlock Classes="caption" Text="{Binding StatusMessage}"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Border Classes="tile" Padding="10" IsVisible="{Binding HasWorkspace}">
                  <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0">
                      <TextBlock Classes="overline" Text="Projects" />
                      <TextBlock Text="{Binding ProjectCount}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="overline" Text="Symbols" />
                      <TextBlock Text="{Binding SymbolCount, StringFormat='{}{0:N0}'}"
                                 FontWeight="SemiBold" />
                    </StackPanel>
                  </Grid>
                </Border>

                <TextBlock Classes="overline" Text="What indexing could not do" Margin="0,6,0,0"
                           IsVisible="{Binding HasDiagnostics}" />
              </StackPanel>

              <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding Diagnostics}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="model:IndexDiagnostic">
                      <Border Classes="tile" Padding="10" Margin="0,0,0,8">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Project}" Classes="caption"
                                     FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding Project, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <TextBlock Text="{Binding Message}" Classes="caption"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>

            <!-- Explorer -->
            <TreeView IsVisible="{Binding ActiveSection, Converter={StaticResource Is},
                                 ConverterParameter={x:Static vm:AppSection.Explorer}}"
                      ItemsSource="{Binding ProjectNodes}"
                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,3">
                    <TextBlock Grid.Column="0" Width="20" TextAlignment="Center"
                               Text="{Binding Glyph}" FontSize="11"
                               Classes.strong="{Binding IsContainer}"
                               Classes.dimmer="{Binding !IsContainer}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                               Classes.strong="{Binding IsProject}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Classes="chip warning" IsVisible="{Binding !IsLoaded}">
                      <TextBlock Text="not loaded" />
                    </Border>
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem
                            Header="Open in editor"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenExternallyCommand}"
                            CommandParameter="{Binding}" />
                      </ContextMenu>
                    </Grid.ContextMenu>
                  </Grid>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <!-- Endpoints -->
            <DockPanel IsVisible="{Binding ActiveSection, Converter={StaticResource Is},
                                   ConverterParameter={x:Static vm:AppSection.Endpoints}}">
              <TextBox DockPanel.Dock="Top" Margin="2,4,2,10"
                       Theme="{DynamicResource SearchBoxTheme}"
                       PlaceholderText="Search endpoints…"
                       IsVisible="{Binding HasAnyEndpoints}"
                       Text="{Binding EndpointFilter, Mode=TwoWay}" />

              <Panel>
                <ListBox ItemsSource="{Binding Endpoints}"
                         SelectedItem="{Binding SelectedEndpoint, Mode=TwoWay}"
                         Theme="{DynamicResource ResultListTheme}"
                         ItemContainerTheme="{DynamicResource ResultRowTheme}"
                         IsVisible="{Binding HasEndpoints}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EndpointViewModel">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Classes="verb"
                                Classes.get="{Binding IsGet}"
                                Classes.post="{Binding IsPost}"
                                Classes.put="{Binding IsPut}"
                                Classes.delete="{Binding IsDelete}"
                                VerticalAlignment="Top">
                          <TextBlock Text="{Binding HttpMethod}" />
                        </Border>
                        <StackPanel Grid.Column="1" MinWidth="0">
                          <!-- Wrapped, not trimmed: a real route's distinguishing part is
                               its tail, which is exactly what an ellipsis eats. -->
                          <TextBlock Text="{Binding Route}" Classes="mono strong"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Handler}" Classes="caption"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem
                                Header="Open in editor"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenExternallyCommand}"
                                CommandParameter="{Binding}" />
                          </ContextMenu>
                        </Grid.ContextMenu>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            IsVisible="{Binding !HasEndpoints}">
                  <TextBlock Text="No endpoints" Classes="section" HorizontalAlignment="Center" />
                  <TextBlock Classes="meta" HorizontalAlignment="Center"
                             TextAlignment="Center" TextWrapping="Wrap"
                             Text="Nothing in scope declares an attribute-routed controller action or a Minimal API route with a literal template." />
                </StackPanel>
              </Panel>
            </DockPanel>
          </Panel>
        </DockPanel>
      </Border>

      <!-- ============ The code, read-only ============ -->

      <Border Grid.Column="1" Classes="card" ClipToBounds="True">
        <DockPanel>

          <Border DockPanel.Dock="Top" Padding="16,12"
                  BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
              <Path Grid.Column="0" Classes="icon" Data="{DynamicResource Icon.Code}"
                    Width="15" Height="15" />
              <TextBlock Grid.Column="1" Text="{Binding Source.FileName}" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Source.Breadcrumb}" Classes="meta"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Source.FilePath}" />
              <Border Grid.Column="3" Classes="chip">
                <TextBlock Text="C#" />
              </Border>
              <Button Grid.Column="4" Theme="{DynamicResource GhostButtonTheme}"
                      Content="Open in editor" FontSize="12"
                      IsVisible="{Binding HasSource}"
                      Command="{Binding OpenExternallyCommand}" />
            </Grid>
          </Border>

          <Border DockPanel.Dock="Bottom" Padding="16,6"
                  BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right"
                        IsVisible="{Binding HasSource}">
              <TextBlock Classes="caption" Text="{Binding Source.Line, StringFormat='Ln {0}'}" />
              <TextBlock Classes="caption" Text="{Binding Source.LineCount, StringFormat='{}{0:N0} lines'}" />
              <TextBlock Classes="caption" Text="Read-only" />
              <TextBlock Classes="caption" Text="C#" />
            </StackPanel>
          </Border>

          <Panel>
            <editor:TextEditor Name="Code"
                               IsReadOnly="True"
                               ShowLineNumbers="True"
                               Background="Transparent"
                               Padding="8,10"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="12.5"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               IsVisible="{Binding HasSource}" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" MaxWidth="420"
                        IsVisible="{Binding !HasSource}">
              <Border Classes="glyph large" HorizontalAlignment="Center">
                <Path Classes="icon" Data="{DynamicResource Icon.Code}" Width="18" Height="18" />
              </Border>
              <TextBlock Classes="section" HorizontalAlignment="Center"
                         Text="No file open"
                         IsVisible="{Binding HasWorkspace}" />
              <TextBlock Classes="section" HorizontalAlignment="Center"
                         Text="No solution open"
                         IsVisible="{Binding !HasWorkspace}" />
              <TextBlock Classes="meta" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap"
                         Text="Pick an endpoint or a symbol and the code it is declared in opens here. CodeAtlas indexes locally and never sends anything anywhere." />
            </StackPanel>
          </Panel>
        </DockPanel>
      </Border>

      <!-- ============ Endpoint details: the request execution flow ============ -->

      <Border Grid.Column="2" Classes="card" Width="{DynamicResource DetailsWidth}"
              ClipToBounds="True"
              IsVisible="{Binding HasSelectedEndpoint}">
        <DockPanel Margin="16,14">

          <StackPanel DockPanel.Dock="Top" Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Endpoint Details" FontSize="15" FontWeight="SemiBold" />
              <Button Grid.Column="1" Theme="{DynamicResource GhostButtonTheme}"
                      Content="Open in editor" FontSize="12"
                      Command="{Binding OpenExternallyCommand}"
                      CommandParameter="{Binding SelectedEndpoint}" />
            </Grid>

            <!-- A Grid, not a horizontal StackPanel: a StackPanel measures its children
                 unbounded, so the route would never trim. -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Grid.Column="0" Classes="verb"
                      Classes.get="{Binding SelectedEndpoint.IsGet}"
                      Classes.post="{Binding SelectedEndpoint.IsPost}"
                      Classes.put="{Binding SelectedEndpoint.IsPut}"
                      Classes.delete="{Binding SelectedEndpoint.IsDelete}"
                      VerticalAlignment="Top" Margin="0,3,0,0">
                <TextBlock Text="{Binding SelectedEndpoint.HttpMethod}" />
              </Border>
              <StackPanel Grid.Column="1" MinWidth="0">
                <TextBlock Text="{Binding SelectedEndpoint.Route}" Classes="mono"
                           FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedEndpoint.Handler}" Classes="meta"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="18">
              <RadioButton Theme="{DynamicResource TabTheme}" GroupName="DetailsTab"
                           Content="Execution Trace"
                           IsChecked="{Binding DetailsTab, Mode=TwoWay,
                                       Converter={StaticResource Is},
                                       ConverterParameter={x:Static vm:DetailsTab.ExecutionTrace}}" />
              <RadioButton Theme="{DynamicResource TabTheme}" GroupName="DetailsTab"
                           Content="Overview"
                           IsChecked="{Binding DetailsTab, Mode=TwoWay,
                                       Converter={StaticResource Is},
                                       ConverterParameter={x:Static vm:DetailsTab.Overview}}" />
            </StackPanel>

            <Border Classes="divider" />
          </StackPanel>

          <Panel Margin="0,14,0,0">

            <!-- Execution Trace -->
            <DockPanel IsVisible="{Binding DetailsTab, Converter={StaticResource Is},
                                   ConverterParameter={x:Static vm:DetailsTab.ExecutionTrace}}">
              <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
                <TextBlock Text="Request Execution Flow" FontWeight="SemiBold" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="{Binding TraceSummary}" />
              </StackPanel>

              <Panel>
                <ListBox ItemsSource="{Binding Trace}"
                         SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                         Theme="{DynamicResource ResultListTheme}"
                         ItemContainerTheme="{DynamicResource ResultRowTheme}"
                         IsVisible="{Binding HasTrace}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TraceStepViewModel">
                      <!-- The gutter carries the tree: a rail down the column the step it
                           follows from sits in, and an elbow into this one. -->
                      <Grid ColumnDefinitions="Auto,*">
                        <Panel Grid.Column="0" Width="{Binding GutterWidth}"
                               IsVisible="{Binding HasGutter}">
                          <Rectangle Width="1" HorizontalAlignment="Right" Margin="0,0,11,0"
                                     Fill="{DynamicResource BorderSubtleBrush}" />
                          <Rectangle Height="1" Width="10"
                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Fill="{DynamicResource BorderSubtleBrush}" />
                        </Panel>

                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                          <Border Grid.Column="0" Classes="stepnumber">
                            <TextBlock Text="{Binding Number}" />
                          </Border>
                          <StackPanel Grid.Column="1" MinWidth="0" Spacing="1">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                              <TextBlock Grid.Column="0" Text="{Binding Display}"
                                         FontWeight="Medium"
                                         TextTrimming="CharacterEllipsis" />
                              <Border Grid.Column="1" Classes="chip"
                                      IsVisible="{Binding HasRelation}"
                                      ToolTip.Tip="Runs in place of the step above it">
                                <TextBlock Text="{Binding Relation}" />
                              </Border>
                            </Grid>
                            <TextBlock Text="{Binding Container}" Classes="caption"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                              <TextBlock Grid.Column="0" Text="{Binding Origin}" Classes="caption" />
                              <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="caption"
                                         Foreground="{DynamicResource WarningBrush}"
                                         IsVisible="{Binding HasNote}"
                                         TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </StackPanel>
                        </Grid>

                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem
                                Header="Open in editor"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenExternallyCommand}"
                                CommandParameter="{Binding}" />
                          </ContextMenu>
                        </Grid.ContextMenu>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Classes="meta" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center"
                           IsVisible="{Binding !HasTrace}"
                           Text="{Binding TraceSummary}" />
              </Panel>
            </DockPanel>

            <!-- Overview -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding DetailsTab, Converter={StaticResource Is},
                                      ConverterParameter={x:Static vm:DetailsTab.Overview}}">
              <ItemsControl ItemsSource="{Binding SelectedEndpoint.Details}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DetailRow">
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="10" Margin="0,0,0,10">
                      <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="meta" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}"
                                           FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
